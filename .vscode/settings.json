{
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "dart.lineLength": 80,
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true
  }
}
